<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!--
            Invoice Report
-->
<template id="report_invoice_document_inherit" inherit_id="account.report_invoice_document">
    <xpath expr="//div[@id='informations']" position="before">
        <p></p>
    </xpath>
    <xpath expr="//div[@id='informations']" position="after">
        <p></p>
    </xpath>

    <xpath expr="//div[@id='total']" position="before">
        <p></p>
    </xpath>
    <xpath expr="//div[@id='total']" position="after">
        <p></p>
    </xpath>

    <xpath expr="//span[@t-field='line.quantity']" position="replace">
        <span t-esc="round(line.quantity)"/>
    </xpath>

    <xpath expr="//span[@t-field='line.price_unit']" position="replace">
        <span class="text-nowrap" t-field="line.price_unit" t-if="not line.so_line_id"/>
        <span class="text-nowrap" t-field="line.so_line_id.price_unit" t-if="line.so_line_id"/>
    </xpath>

    <xpath expr="//span[@t-field='line.discount']" position="replace">
        <span class="text-nowrap" style="color:blue" t-field="line.discount" t-if="not line.so_line_id"/>
        <span class="text-nowrap" style="color:blue" t-field="line.so_line_id.discount" t-if="line.so_line_id"/>
    </xpath>

    <xpath expr="//tr[@class='border-black o_subtotal']" position="replace">
        <tr class="border-black o_subtotal" style="">
            <td><strong>Subtotal ex. vat</strong></td>
            <td class="text-right">
                <span t-field="o.amount_untaxed"/>
            </td>
        </tr>
    </xpath>

</template>

</odoo>
