<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Invoice -->
        <record id="view_move_form" model="ir.ui.view">
            <field name="name">account.invoice.form.EOT</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form" />
            <field name="arch" type="xml">
                <xpath expr="//sheet/notebook/page/field[@name='invoice_line_ids']/tree/field[@name='name']" position="after">
                    <field name="lock_prices" invisible="1"/>
                </xpath>
                <xpath expr="//sheet/notebook/page/field[@name='invoice_line_ids']/tree/field[@name='price_unit']" position="attributes">
                    <attribute name="attrs">{'readonly':[('lock_prices','=',True)]}</attribute>
                </xpath>
                <xpath expr="//sheet/notebook/page/field[@name='invoice_line_ids']/tree/field[@name='discount']" position="attributes">
                    <attribute name="attrs">{'readonly':[('lock_prices','=',True)]}</attribute>
                </xpath>

            </field>
        </record>
    </data>
</odoo>
